{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        "nickname": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
        },
        "wins": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 1) : newData.val() <= 1)"
        },
        "losses": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 1) : newData.val() <= 1)"
        },
        "gamesPlayed": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 1) : newData.val() <= 1)"
        },
        "totalPoints": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() ? (newData.val() >= data.val() && newData.val() <= data.val() + 400) : newData.val() <= 400)"
        },
        "level": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500 && (data.exists() ? newData.val() >= data.val() : true)"
        },
        "currentXP": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "rating": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000"
        },
        "ratingDeviation": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 500"
        },
        "ratingVolatility": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 0.2"
        },
        "lastGameAt": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        },

        "history": {
          "$entry": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['date', 'result', 'boardSize'])",
            "date":        { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 3600000" },
            "result":      { ".validate": "newData.isString() && newData.val().matches(/^(win|loss|draw)$/)" },
            "boardSize":   { ".validate": "newData.isNumber() && (newData.val() === 9 || newData.val() === 13 || newData.val() === 19)" },
            "opponent":    { ".validate": "newData.isString() && newData.val().length <= 40" },
            "gameId":      { ".validate": "newData.isString() && newData.val().length <= 40" },
            "aiVisits":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50000" },
            "moveCount":   { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 1000" },
            "ratingAfter": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 4000" },
            "accuracy":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "sgf":         { ".validate": "newData.isString() && newData.val().length <= 20000" },
            "$other":      { ".validate": false }
          }
        }
      }
    },

    "games": {
      ".read": "auth != null",
      ".indexOn": ["isPublic"],

      "$gameId": {
        ".write": "$gameId.matches(/^[0-9]{4}$/) && auth != null && ( (!data.exists() && newData.child('players/black/uid').val() === auth.uid && newData.child('status').val() === 'waiting') || (data.exists() && newData.exists() && (data.child('players/black/uid').val() === auth.uid || data.child('players/white/uid').val() === auth.uid)) || (data.exists() && newData.exists() && data.child('status').val() === 'waiting' && !data.child('players/white').exists() && newData.child('players/white/uid').val() === auth.uid) || (!newData.exists() && data.child('createdAt').val() < (now - 151200000)) )",

        "status":    { ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|finished)$/)" },
        "boardSize": { ".validate": "newData.isNumber() && (newData.val() === 9 || newData.val() === 13 || newData.val() === 19)" },
        "isPublic":  { ".validate": "newData.isBoolean()" },

        "players": {
          "black": {
            "uid": { ".validate": "!data.exists() || data.val() === newData.val()" }
          },
          "white": {
            "uid": { ".validate": "!data.exists() || data.val() === newData.val()" }
          }
        },

        "chat": {
          "$msg": {
            "uid":  { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" }
          }
        }
      }
    }
  }
}
